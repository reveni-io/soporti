{
  "name": "soporti-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Express + OpenAI Agents SDK backend for Soporti, running against OpenAI or Anthropic.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/reveni-io/soporti.git",
    "directory": "server"
  },
  "license": "Apache-2.0",
  "author": "Reveni",
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "lint": "eslint src/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "~3.0.103",
    "@modelcontextprotocol/server": "^2.4.0",
    "@octokit/rest": "^22.0.1",
    "@openai/agents": "^0.21.0",
    "@openai/agents-extensions": "^0.21.0",
    "@slack/bolt": "^4.7.3",
    "bcryptjs": "^3.0.3",
    "beautiful-mermaid": "^1.1.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.4",
    "exceljs": "^4.4.0",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.1",
    "fast-xml-parser": "^5.11.2",
    "google-auth-library": "^10.9.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "jszip": "^3.10.2",
    "mammoth": "^1.13.0",
    "openai": "^6.49.0",
    "pg": "^8.23.1",
    "unpdf": "^1.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^4.0.18",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.13.0",
    "eslint-plugin-sonarjs": "^4.2.2",
    "globals": "^17.13.0",
    "supertest": "^7.3.1",
    "vitest": "^4.0.18"
  }
}
