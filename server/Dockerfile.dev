# Development image: installs deps and runs the server with hot-reload.
# Source is bind-mounted by docker-compose; node_modules stays in the image.
# ffmpeg and Chromium's headless shell are there so videos render in dev too.
FROM node:22-bookworm-slim
RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates git ffmpeg \
  && rm -rf /var/lib/apt/lists/*
WORKDIR /app
ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
COPY package.json package-lock.json* ./
RUN npm install \
  && npx playwright-core install --with-deps --only-shell chromium \
  && rm -rf /var/lib/apt/lists/*
COPY . .
EXPOSE 3001
CMD ["npm", "run", "dev"]
