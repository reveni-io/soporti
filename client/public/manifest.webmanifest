{
  "id": "/chat",
  "name": "Soporti",
  "short_name": "Soporti",
  "description": "Your AI teammate for code, data and docs. Ask how your product works and Soporti reads the code, queries data and searches docs, tickets and errors, then explains it in plain language.",
  "lang": "en",
  "dir": "ltr",
  "start_url": "/chat",
  "scope": "/",
  "display": "standalone",
  "theme_color": "#042503",
  "background_color": "#042503",
  "categories": ["business", "productivity", "utilities"],
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    {
      "name": "New chat",
      "short_name": "Chat",
      "description": "Ask Soporti a new question",
      "url": "/chat",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Bots",
      "description": "Open your bots and their routines",
      "url": "/bots",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Analytics",
      "description": "Open your dashboards",
      "url": "/analytics",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Videos",
      "description": "Open your product videos",
      "url": "/videos",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ],
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "files",
          "accept": [
            "image/png",
            "image/jpeg",
            "image/webp",
            "image/gif",
            "application/pdf",
            "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
            "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
            "text/csv",
            ".png",
            ".jpg",
            ".jpeg",
            ".webp",
            ".gif",
            ".pdf",
            ".docx",
            ".xlsx",
            ".csv"
          ]
        }
      ]
    }
  },
  "screenshots": [
    {
      "src": "/tour/data-answer.png",
      "sizes": "1392x1082",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Soporti answering a data question with a table"
    }
  ]
}
